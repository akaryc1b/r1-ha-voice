#!/bin/sh /etc/rc.common
START=99
STOP=9
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/docker exec r1-apple-music python -u /data/r1-cloud-voice/voice_gateway.py
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    /usr/bin/docker exec r1-apple-music python -c 'import pathlib,os,signal;target=b"/data/r1-cloud-voice/voice_gateway.py";[(os.kill(int(p.name),signal.SIGTERM)) for p in pathlib.Path("/proc").iterdir() if p.name.isdigit() and target in (p/"cmdline").read_bytes().split(b"\0")]'
}
