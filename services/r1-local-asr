#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    local task_root="/mnt/mmcblk2p4/r1-asr-eval-20261013"
    procd_open_instance
    procd_set_param command /usr/bin/python3 "$task_root/server_launcher.py" --port=16066 --num-threads=2 --num-work-threads=1 --num-io-threads=1 --max-batch-size=1 --model-type=zipformer --tokens="$task_root/tokens.txt" --encoder="$task_root/encoder-epoch-99-avg-1.int8.onnx" --decoder="$task_root/decoder-epoch-99-avg-1.int8.onnx" --joiner="$task_root/joiner-epoch-99-avg-1.int8.onnx" --decoding-method=modified_beam_search --hotwords-file="$task_root/music-hotwords.txt" --hotwords-score=1.5 --rule2-min-trailing-silence=1.3 --rule1-min-trailing-silence=4 --log-file=/tmp/r1-local-asr.log --print-args=false
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
