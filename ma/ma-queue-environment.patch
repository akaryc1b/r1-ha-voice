+                    encoded_request_url(url), headers=headers, auto_decompress=False,
+                    timeout=ClientTimeout(total=None, connect=8, sock_read=15),
+                ) as response:
+                    if response.status != (206 if offset else 200):
+                        raise AudioError(f"Apple audio HTTP status {response.status}")
+                    if offset:
+                        matched = re.fullmatch(r"bytes ([0-9]+)-([0-9]+)/([0-9]+|\*)", response.headers.get("Content-Range", ""))
+                        if matched is None or int(matched[1]) != offset:
