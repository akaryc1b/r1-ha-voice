+        """顺序读取 Apple 音频；断线按已交付字节续传，不重复或跳过数据。"""
+        offset = 0
+        validator = None
+        for attempt in range(3):
+            headers = {"Accept-Encoding": "identity"}
+            if offset:
+                headers["Range"] = f"bytes={offset}-"
+                if validator:
+                    headers["If-Range"] = validator
+            try:
