+    async def _preload_r1_idle_resume(self, queue_id: str, item_id: str, attempt: int = 0, refresh: bool = False) -> None:
+        """启动时只准备现有待机曲目的播放详情，不收音、不创建 PCM 流。"""
+        data = self._queue_data.get(queue_id)
+        if data is None or data.queue.state != PlaybackState.IDLE or data.transitioning:
+            return
+        current = data.queue.current_item
+        item = self.get_item(queue_id, item_id)
+        current_index = data.queue.current_index
+        if item is None or item.media_type != MediaType.TRACK:
+            return
+        if (current is not None and current.queue_item_id != item_id) or self.get_item(queue_id, current_index) is not item:
+            return
+        session = data.session_id
+        original_details = item.streamdetails
+        candidate = copy(item)
+        if original_details is not None and not refresh:
+            candidate.streamdetails = copy(original_details)
+        elif refresh:
+            candidate.streamdetails = None
+        try:
+            await asyncio.wait_for(self._load_item(candidate), timeout=30)
+        except (AudioError, MediaNotFoundError, ProviderUnavailableError, TimeoutError) as error:
+            self.logger.info("R1 idle details prefetch unavailable: %s", type(error).__name__)
+            # 音源可能晚于队列就绪；仅启动预取有界重试，不周期取流。
+            if (
+                (isinstance(error, (MediaNotFoundError, ProviderUnavailableError)) and attempt < 6)
+                or (refresh and attempt < 2)
+            ):
+                self.mass.call_later(
+                    5, self._preload_r1_idle_resume, queue_id, item_id, attempt + 1, refresh,
+                    task_id=f"r1_idle_details_retry_{queue_id}",
+                )
+            return
+        if (
+            self._queue_data.get(queue_id) is data
+            and data.session_id == session
+            and data.queue.state == PlaybackState.IDLE
+            and not data.transitioning
+            and data.queue.current_index == current_index
+            and (data.queue.current_item is None or data.queue.current_item.queue_item_id == item_id)
+            and self.get_item(queue_id, item_id) is item
+            and item.streamdetails is original_details
+        ):
+            item.streamdetails = candidate.streamdetails
+            if data.queue.current_item is not None and data.queue.current_item is not item:
+                data.queue.current_item.streamdetails = candidate.streamdetails
+            self.logger.info("R1_IDLE_DETAILS_PREFETCH ready=true")
+            details = candidate.streamdetails
+            if R1_IDLE_DETAILS_REFRESH and details is not None and details.expiration > 0:
+                delay = max(30, details.created_at + details.expiration - time.time() - 30)
+                self.mass.call_later(
+                    delay, self._preload_r1_idle_resume, queue_id, item_id, 0, True,
+                    task_id=f"r1_idle_details_refresh_{queue_id}",
+                )
 
