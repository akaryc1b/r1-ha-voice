+
+    async def _preload_r1_idle_resume(self, queue_id: str, item_id: str, attempt: int = 0) -> None:
+        """启动时只准备现有待机曲目的播放详情，不收音、不创建 PCM 流。"""
+        data = self._queue_data.get(queue_id)
+        if data is None or data.queue.state != PlaybackState.IDLE or data.transitioning:
+            return
+        current = data.queue.current_item
+        item = self.get_item(queue_id, item_id)
+        if current is None or current.queue_item_id != item_id or item is None or item.media_type != MediaType.TRACK:
+            return
+        session = data.session_id
+        original_details = item.streamdetails
+        candidate = copy(item)
+        if original_details is not None:
+            candidate.streamdetails = copy(original_details)
+        try:
+            await asyncio.wait_for(self._load_item(candidate), timeout=8)
+        except (AudioError, MediaNotFoundError, TimeoutError) as error:
+            self.logger.info("R1 idle details prefetch unavailable: %s", type(error).__name__)
+            # 音源可能晚于队列就绪；仅启动预取有界重试，不周期取流。
+            if isinstance(error, MediaNotFoundError) and attempt < 3:
+                self.mass.call_later(
+                    5, self._preload_r1_idle_resume, queue_id, item_id, attempt + 1,
+                    task_id=f"r1_idle_details_retry_{queue_id}",
+                )
+            return
+        if (
+            self._queue_data.get(queue_id) is data
+            and data.session_id == session
+            and data.queue.state == PlaybackState.IDLE
+            and not data.transitioning
+            and data.queue.current_item is current
+            and self.get_item(queue_id, item_id) is item
+            and item.streamdetails is original_details
+        ):
+            item.streamdetails = candidate.streamdetails
+            if current is not item:
+                current.streamdetails = candidate.streamdetails
+            self.logger.info("R1_IDLE_DETAILS_PREFETCH ready=true")
 
