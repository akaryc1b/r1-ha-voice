+            return
+        current = data.queue.current_item
+        item = self.get_item(queue_id, item_id)
+        current_index = data.queue.current_index
+        if item is None or item.media_type != MediaType.TRACK:
+            return
+        if (current is not None and current.queue_item_id != item_id) or self.get_item(queue_id, current_index) is not item:
+            return
+        session = data.session_id
+        original_details = item.streamdetails
+        candidate = copy(item)
+        if original_details is not None and not refresh:
+            candidate.streamdetails = copy(original_details)
+        elif refresh:
+            candidate.streamdetails = None
+        try:
+            await asyncio.wait_for(self._load_item(candidate), timeout=30)
+        except (AudioError, MediaNotFoundError, ProviderUnavailableError, TimeoutError) as error:
+            self.logger.info("R1 idle details prefetch unavailable: %s", type(error).__name__)
+            # 音源可能晚于队列就绪；仅启动预取有界重试，不周期取流。
