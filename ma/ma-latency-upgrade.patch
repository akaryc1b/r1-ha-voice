+    async def _preload_r1_idle_resume(self, queue_id: str, item_id: str, attempt: int = 0, refresh: bool = False) -> None:
+        """启动时只准备现有待机曲目的播放详情，不收音、不创建 PCM 流。"""
+        data = self._queue_data.get(queue_id)
