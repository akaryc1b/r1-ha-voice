--- /dev/null
+++ b/music_assistant/providers/snapcast/r1_hardware_volume.py
@@ -0,0 +1,95 @@
+"""Optional direct hardware volume for an R1 Snapcast output.
+
+The Snapcast software gain stays at unity; only Android STREAM_MUSIC is changed.
+An empty URL keeps the normal Snapcast client behavior.
+"""
+from __future__ import annotations
+
+import asyncio
+import time
+from collections.abc import Awaitable, Callable
+from urllib.parse import urlsplit
+
+from aiohttp import ClientSession, ClientTimeout
+
+CONF_R1_HARDWARE_VOLUME_URL = "r1_hardware_volume_url"
+HARDWARE_PLAYING_INTERVAL = 2.0
+HARDWARE_IDLE_INTERVAL = 10.0
+SERVER_STATUS_INTERVAL = 5.0
+
+
+async def refresh_server_status(provider) -> None:
+    """跨播放器合并状态刷新；失败也计时，慢请求未完成时不重叠请求。"""
+    now = provider.mass.loop.time()
+    previous = getattr(provider, "_r1_status_refresh_attempt", None)
+    if getattr(provider, "_r1_status_refresh_inflight", False):
+        return
+    if previous is not None and now - previous < SERVER_STATUS_INTERVAL:
+        return
+    provider._r1_status_refresh_attempt = now
+    provider._r1_status_refresh_inflight = True
+    try:
+        await provider.refresh_server_status()
+    finally:
+        provider._r1_status_refresh_inflight = False
+
+
+class R1HardwareVolume:
+    """Read actual device steps and preserve hardware mute restoration."""
+
+    def __init__(self, session: ClientSession, url: str, *, clock: Callable[[], float] = time.monotonic) -> None:
+        parsed = urlsplit(url)
+        if (
+            parsed.scheme not in ("http", "https")
+            or not parsed.hostname
+            or parsed.username
+            or parsed.password
+            or parsed.query
+            or parsed.fragment
+            or parsed.path.rstrip("/") != "/voice_volume"
+        ):
+            raise ValueError("Use the R1 /voice_volume endpoint without credentials or query")
+        self.session = session
+        self.url = url
+        self.percent: int | None = None
+        self.muted = False
+        self._lock = asyncio.Lock()
+        self._clock = clock
+        self._last_attempt: float | None = None
+
+    async def poll(self, playing: bool, *, before_read: Callable[[], Awaitable[None]] | None = None) -> bool:
+        """被动回读独立节流；失败/取消后的时间戳同样防止快速重试。"""
+        interval = HARDWARE_PLAYING_INTERVAL if playing else HARDWARE_IDLE_INTERVAL
+        async with self._lock:
+            now = self._clock()
+            if self._last_attempt is not None and now - self._last_attempt < interval:
+                return False
+            self._last_attempt = now
+            if before_read is not None:
+                await before_read()
+            await self._request_locked("get", 0)
+            return True
+
+    async def request(self, operation: str = "get", percent: int = 0) -> tuple[int, bool]:
+        if operation not in ("get", "set", "mute", "unmute"):
+            raise ValueError("Invalid R1 music volume operation")
+        if not 0 <= percent <= 100:
+            raise ValueError("Invalid R1 music volume percent")
+        async with self._lock:
+            self._last_attempt = self._clock()
+            return await self._request_locked(operation, percent)
+
+    async def _request_locked(self, operation: str, percent: int) -> tuple[int, bool]:
+        async with self.session.get(
+            self.url,
+            params={"target": "music", "operation": operation, "percent": percent},
+            timeout=ClientTimeout(total=1.0),
+        ) as response:
+            response.raise_for_status()
+            result = await response.json()
+        value = result.get("percent")
+        if result.get("target") != "music" or type(value) is not int or not 0 <= value <= 100:
+            raise ValueError("Invalid R1 music volume response")
+        self.percent = value
+        self.muted = value == 0
+        return self.percent, self.muted
